# À copier/fusionner dans le .env (dev) ou .env.prod (prod) à la racine du dépôt.
# Docker Compose charge automatiquement le .env du dossier courant, quel que soit
# le nombre de fichiers -f passés en ligne de commande.

# Mot de passe du compte admin Grafana (défaut "admin" si absent — à changer en prod)
GRAFANA_ADMIN_PASSWORD=change-me

# URL du webhook Discord utilisé pour les alertes (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# URL publique de Grafana, utilisée pour générer les liens dans les notifications
# (Source, Silence...). Défaut "http://localhost:3001/" en dev. En production,
# remplacer par l'URL réelle (ex. https://supervision.mazworld.example.com/).
GRAFANA_ROOT_URL=http://localhost:3001/
